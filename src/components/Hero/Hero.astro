---
import WteLogo from "./wtelogo/WteLogo.svelte";
import InstallOptions from "./InstallCommand/InstallOptions.svelte";

const asciiArt = `                 ▄▄▄
 ▄█████▄    ▄███████████▄    ▄███████   ▄███████   ▄███████   ▄█   █▄    ▄█   █▄
███   ███  ███   ███   ███  ███   ███  ███   ███  ███   ███  ███   ███  ███   ███
███   ███  ███   ███   ███  ███   ███  ███   ███  ███   █▀   ███   ███  ███   ███
███   ███  ███   ███   ███ ▄███▄▄▄███ ▄███▄▄▄██▀  ███       ▄███▄▄▄███▄ ███▄▄▄███
███   ███  ███   ███   ███ ▀███▀▀▀███ ▀███▀▀▀▀    ███      ▀▀███▀▀▀███  ▀▀▀▀▀▀███
███   ███  ███   ███   ███  ███   ███ ██████████  ███   █▄   ███   ███  ▄██   ███
███   ███  ███   ███   ███  ███   ███  ███   ███  ███   ███  ███   ███  ███   ███
 ▀█████▀    ▀█   ███   █▀   ███   █▀   ███   ███  ███████▀   ███   █▀    ▀█████▀
                                       ███   █▀
`;
---

<section
	class="w-full flex flex-col gap-8 text-center bg-cover bg-no-repeat min-h-screen"
	style="background-image: var(--hero-bg-image);"
>
	<div
		class="w-full min-h-screen flex items-center justify-center bg-(--color-background)/[60%] py-12"
	>
		<div class="w-full px-4 flex flex-col items-center gap-6">
			<a
				href="/omarchy-redesign"
				aria-label="Omarchy"
				class="max-w-full overflow-hidden"
			>
				<WteLogo text={asciiArt} effect="laseretch" client:load />
			</a>

			<p class="text-sm text-text sm:text-base font-bold">
				Beautiful, Fun &amp; Agentic Linux by <a
					href="https://x.com/dhh"
					target="_blank"
					rel="noopener noreferrer"
					class="text-link underline decoration-dotted underline-offset-4 transition-colors duration-fast hover:text-link-hover"
					>DHH</a
				>
			</p>

			<p
				class="text-balance text-text-muted font-bold text-sm sm:text-base"
			>
				The malleable OS for the age of agents. Where you can vibe your
				way through every alteration, tweak, and desire. <a
					href="https://omarchs.fyi"
					class="text-link underline decoration-dotted underline-offset-4 transition-colors duration-fast hover:text-link-hover"
					>Be the Omarch</a
				> and command your agent!
			</p>

			<div class="flex w-full flex-col items-center gap-4 pt-4">
				<InstallOptions client:load />

				<div
					class="flex flex-wrap items-center justify-center gap-3 text-sm pt-2"
				>
					<a
						href="https://omarchy.org/manual"
						class="rounded-md border border-border px-4 py-2 text-text transition-colors duration-fast hover:border-link hover:text-link bg-background-storm/60"
					>
						Read the Manual
					</a>
					<a
						href="https://github.com/omacom/omarchy"
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-md border border-border px-4 py-2 text-text transition-colors duration-fast hover:border-link hover:text-link bg-background-storm/60"
					>
						View on GitHub
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
