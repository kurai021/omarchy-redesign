---
// Runs at BUILD TIME only (Astro frontmatter = server-side).
// The visitor's browser never calls the GitHub API directly.
//
// Fallback snapshot in case the build environment is offline or rate-limited —
// update these occasionally so the fallback doesn't go stale.
const FALLBACK = {
  stars: 34300,
  forks: 3500,
  commits: 6222,
};

async function fetchRepoStats() {
  try {
    const res = await fetch("https://api.github.com/repos/omacom/omarchy", {
      headers: { Accept: "application/vnd.github+json" },
    });
    if (!res.ok) throw new Error(`GitHub API responded ${res.status}`);
    const data = await res.json();

    // Total commit count isn't a direct field — GitHub exposes it via the
    // Link header's "last page" trick on the commits endpoint.
    let commits = FALLBACK.commits;
    try {
      const commitsRes = await fetch(
        "https://api.github.com/repos/omacom/omarchy/commits?sha=quattro&per_page=1",
        { headers: { Accept: "application/vnd.github+json" } }
      );
      const link = commitsRes.headers.get("link");
      const match = link?.match(/&page=(\d+)>; rel="last"/);
      if (match) commits = parseInt(match[1], 10);
    } catch {
      // keep fallback commit count
    }

    return {
      stars: data.stargazers_count ?? FALLBACK.stars,
      forks: data.forks_count ?? FALLBACK.forks,
      commits,
    };
  } catch {
    return FALLBACK;
  }
}

const stats = await fetchRepoStats();

function formatCompact(n) {
  return new Intl.NumberFormat("en", { notation: "compact", maximumFractionDigits: 1 }).format(n);
}

const metrics = [
  { label: "Raised for the Foundation", value: "$12.6M" },
  { label: "GitHub stars", value: formatCompact(stats.stars) },
  { label: "Forks", value: formatCompact(stats.forks) },
  { label: "Commits on Quattro", value: formatCompact(stats.commits) },
];
---

<section class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
  <div class="mx-auto text-center">
    <h2 class="text-xl font-semibold text-text-strong sm:text-4xl">
      Real numbers, not adjectives
    </h2>
    <p class="mt-3 text-text-muted">
      Pulled straight from the repo and the Foundation's own numbers.
    </p>
  </div>

  <div class="mt-12 grid grid-cols-2 gap-6 sm:grid-cols-4">
    {metrics.map((metric) => (
      <div class="flex flex-col items-center gap-1 rounded-lg border border-border bg-background-storm/40 py-6 text-center">
        <span class="font-display text-3xl font-bold text-accent sm:text-4xl">
          {metric.value}
        </span>
        <span class="text-xs text-text-muted sm:text-sm">{metric.label}</span>
      </div>
    ))}
  </div>
</section>
