---
import Stats from "./Stats.svelte";

const FALLBACK = {
	stars: 34300,
	forks: 3500,
	commits: 6222,
	plugins: 1900,
};

async function fetchRepoStats() {
	try {
		const res = await fetch("https://api.github.com/repos/omacom/omarchy", {
			headers: { Accept: "application/vnd.github+json" },
		});
		if (!res.ok) throw new Error(`GitHub API responded ${res.status}`);
		const data = await res.json();

		let commits = FALLBACK.commits;
		try {
			const commitsRes = await fetch(
				"https://api.github.com/repos/omacom/omarchy/commits?sha=quattro&per_page=1",
				{ headers: { Accept: "application/vnd.github+json" } },
			);
			const link = commitsRes.headers.get("link");
			const match = link?.match(/&page=(\d+)>; rel="last"/);
			if (match) commits = parseInt(match[1], 10);
		} catch {
			// keep fallback
		}

		return {
			stars: data.stargazers_count ?? FALLBACK.stars,
			forks: data.forks_count ?? FALLBACK.forks,
			commits,
		};
	} catch {
		return FALLBACK;
	}
}

const githubStats = await fetchRepoStats();

async function fetchPluginsCounter() {
	try {
		const pluginsRes = await fetch(
			"https://plugins.omarchy.org/catalog.json",
			{
				headers: {
					"Content-Type": "application/json",
				},
			},
		);
		if (!pluginsRes.ok)
			throw new Error(
				`Omarchy PLugins Marketplace responded ${pluginsRes.status}`,
			);
		const data = await pluginsRes.json();

		const plugins = data.plugins;

		return {
			plugins: plugins.length ?? FALLBACK.plugins,
		};
	} catch {
		// keep fallback
	}
}

const pluginStats = await fetchPluginsCounter();
---

<!-- Hidratación diferida: el cliente solo carga e hidrata cuando entra al viewport -->
<Stats
	client:visible
	stars={githubStats.stars}
	forks={githubStats.forks}
	commits={githubStats.commits}
	plugins={pluginStats.plugins}
/>
