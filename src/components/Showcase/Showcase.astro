---
import LiteYouTube from "./LiteYouTube.svelte";
---

<section class="mx-auto px-6 py-16">
  <div class="max-w-5xl mx-auto">
    <div class="mx-auto text-center">
      <h2 class="text-xl font-semibold text-text-strong sm:text-4xl">
        See Quattro in action
      </h2>
      <p class="mt-3 text-text-muted">
        DHH walked through the entire release himself: agent-first design,
        sub-minute installs, a full rewrite on Quickshell, and the new
        community plugin ecosystem. Grab a coffee — it's worth the full watch.
      </p>
    </div>

    <div class="mt-10">
      <LiteYouTube videoId="F7fe9pa8OeE" title="Omarchy Quattro" client:visible />
    </div>
  </div>
</section>
